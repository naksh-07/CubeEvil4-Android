# Patch 0951 (wish of DevJunior, 23.11.2026: "when I reload Ashley goes back instead of stepping aside and shooting
# too"; 16:54: "she still hides or gets scared every time I reload, instead of being alert"). Not a bug of the
# prototype: a port feature with runtime/ashley_gun.cpp (her pistol, patches 0911/0912).
# src/game/pl_npc.cpp cSubChar::moveBehind: the place behind the aiming (or reloading) player, in his model space,
# goes through re4_ashley_behind, which moves it to his side while Ashley carries a pistol and nothing walls it off;
# its motions (covering her ears 0x1D/0x1E/0x1F, flinching 0x20) through re4_ashley_behind_mot, which gives her
# alert stand (0x12, her stand while following) while she carries one.
--- a/src/game/pl_npc.cpp
+++ b/src/game/pl_npc.cpp
@@ -48,6 +48,8 @@
 // MotionSetCore with the sequence table as the 4th argument (declared int in motion.h).
 #define MOT_SET(m, w, data, seq, a, b, c) MotionSetCore(m, w, data, seq, a, b, c)
 
+extern "C" void re4_ashley_behind(cSubChar* a, Vec* t); /* port (patch 0951): runtime/ashley_gun.cpp */
+extern "C" int re4_ashley_behind_mot(int no);           /* port (patch 0951) */
 const Vec cSubChar::atckPos = { -100.0f, 0.0f, -500.0f };
 const Vec cSubChar::atckPos2 = { 300.0f, 0.0f, -500.0f };
 
