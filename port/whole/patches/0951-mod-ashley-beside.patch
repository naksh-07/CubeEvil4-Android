+        re4_ashley_behind(this, &target); /* port (patch 0951, mods): Ashley armed stands at his side */
         PSMTXMultVec(pPL->mat, &target, &target);
         pos.x = pos.x * 0.7f + target.x * 0.3f;
         pos.z = pos.z * 0.7f + target.z * 0.3f;
