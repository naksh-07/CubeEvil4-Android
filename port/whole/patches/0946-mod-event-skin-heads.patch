# Patch 0946 (wish of DevJunior, 22./23.11.2026: "Ashley does not show with the new skins I gave her, nor Ada Wong in the
# cutscene of the mayor's house"; his report 23.11.2026: r117s00 draws Ashley only with event/model/ev0100 parts). Not a
# bug of the prototype: a port feature of the mods (as 0906 for Leon).
# game/event.cpp Event::ExePacket_SetPartsSub: re4_mod_event_skin_part (runtime/dvd.cpp) for the parts of Ashley
# (pl0100) and Ada (pl0200). When the oya's body came from a skin (patch 0915), the skin's head / face replace the
# event's ev0X01 / ev0X02. When the body is the event's own, the skin's whole figure (as the field's: body, face,
# head, outfits, hands) is hung on the oya once, and the oya's own body and the event's parts of the character are
# drawn at scale 0 (their motions and offsets stay); only when the skin's body has no more joints than the oya.
--- a/src/game/event.cpp
+++ b/src/game/event.cpp
@@ -980,6 +980,8 @@
 // Creates the parts cModelInfo from bin/tpl and adds it to parent `oya` (the ev*02 head parts also
 // set the parent's parts offset); registered as model type 3.
 extern "C" int re4_mod_event_head(const char* name, const char* oya); /* port (patch 0906): runtime/dvd.cpp */
+extern "C" int re4_mod_event_skin_part(const char* name, const char* oya, const void* body, int oyaParts, void** bins,
+                                       void** tpls, int max); /* port (patch 0946): runtime/dvd.cpp */
 extern "C" void re4_mod_shape_pair(void* event_info, void* event_model, void* skin_info, void* skin_model); /* port (patch 0907): runtime/dvd.cpp */
 int Event::ExePacket_SetPartsSub(char* nm, char* bin, char* tpl, char* oya)
 {
@@ -1037,6 +1039,60 @@
                 }
             }
         }
+    }
+    /* port (patch 0946, mods): Ashley's and Ada's skins in the cutscenes (DevJunior, 22./23.11.2026). Their body the
+       skin's (patch 0915): the skin's head / face for the event's ev0X01 / ev0X02. Their body the event's own
+       (event/model/ev0100): the skin's whole figure, hung on the oya once, the oya's own body and every event part of
+       the character drawn at scale 0 (as 0906) */
+    {
+        void* sb[8];
+        void* st[8];
+        cModelInfo* base = m->pModelInfo;
+        int own = re4_mod_event_skin_part(nm, oya, base != 0 ? base->model_addr : 0, m->nParts, sb, st, 8);
+
+        if (own == 1 || own == 2) {
+            cModelInfo* skin = ModInfoMgr.create(sb[0], st[0]);
+
+            if (skin != 0) {
+                info->mat[0][0] = 0.0f;
+                info->mat[1][1] = 0.0f;
+                info->mat[2][2] = 0.0f;
+                m->addModel(skin);
+                if (own == 1 && skin->model_addr->shapeOfs != 0 && info->model_addr->shapeOfs != 0
+                    && *(u32*) ((u8*) skin->model_addr + skin->model_addr->shapeOfs)
+                           >= *(u32*) ((u8*) info->model_addr + info->model_addr->shapeOfs)) {
+                    re4_mod_shape_pair(info, info->model_addr, skin, skin->model_addr);
+                }
+            }
+        } else if ((own & 0x100) != 0) {
+            int n = own & 0xFF;
+            int hung = 0;
+            int k;
+            cModelInfo* p;
+
+            for (p = base; p != 0; p = p->pList) {
+                if ((void*) p->model_addr == sb[0]) {
+                    hung = 1;
+                }
+            }
+            info->mat[0][0] = 0.0f;
+            info->mat[1][1] = 0.0f;
+            info->mat[2][2] = 0.0f;
+            if (!hung) {
+                if (base != 0 && base != info) {
+                    base->mat[0][0] = 0.0f;
+                    base->mat[1][1] = 0.0f;
+                    base->mat[2][2] = 0.0f;
+                }
+                for (k = 0; k < n; k++) {
+                    cModelInfo* skin = ModInfoMgr.create(sb[k], st[k]);
+
+                    if (skin != 0) {
+                        m->addModel(skin);
+                    }
+                }
+            }
+        }
     }
     return 1;
 }
