# prompt; its action hands the Ganado the finishers' Dm_NeckBreak (patch 0921) with a finisher of a body face down or
# face up from a mod pack's melee/finish.dat. Declared in re4_whole_prelude.h.
--- a/src/em10/em10.cpp
+++ b/src/em10/em10.cpp
@@ -7773,6 +7773,7 @@
         w->Be_flg |= 0x1000000;
         em->setStatus(EM_STATUS_IK_OFF);
         MotionMove(em, 0);
+        re4_ground_prompt(em); /* port: patch 0928 */
         if (em->l_pl > 6250000.0f && w->pCore && w->Ganado != 1 && w->pCore->ckAtkEnable()) {
             w->pCore->setAtk(1);
         }
