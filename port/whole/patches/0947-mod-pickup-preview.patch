+/* port (patch 0947, mods; DevJunior, 22.11.2026: "I need to know which bullets and grenades I will take, the same
+   text before taking them, when near"): while the action button offers an item (act_btn.cpp, patch 0948), the same
+   short name as the quick pick-up's message ("Handgun Ammo (10)"), at its place, drawn that frame only (no-stop
+   attribute 0x80). Not money (its amount shows as it is taken), not while a pick-up's own message or a remake call
+   shows; with the remake's movements on, as the quick pick-up. */
+extern "C" void re4_pickup_preview(void* arg)
+{
+    SCE_AT_ITEM* w = (SCE_AT_ITEM*) arg;
+    ITEM_INFO info;
+    int num;
+
+    if (w == 0 || w->id != SCEAT_ID_ITEM || !re4_quick_pickup_on() || quickMesBusy > 0 || re4_codec_active()) {
+        return;
+    }
+    itemInfo(w->item.item_id, &info);
+    if (info.type == 8) {
+        return;
+    }
+    num = w->item.item_num;
+    if (num == 0) {
+        num = info.defNum;
+    }
+    sceAtQuickMes(0x15, 0x11, w->item.item_id, num);
+    quickMesSerial--;  /* not a new pick-up: a running pick-up task keeps its count */
+    quickMesShort = sceAtQuickShortBuild(info.type == 2 || num > 1);
+    if (quickMesShort) {
+        sceAtQuickMesShow();
+    }
+}
